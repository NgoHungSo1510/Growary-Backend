{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "lib": [
            "ES2020"
        ],
        "outDir": "./dist",
        "rootDirs": [
            "./src",
            "../shared/types"
        ],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": true,
        "declarationMap": true,
        "moduleResolution": "node",
        "baseUrl": ".",
        "paths": {
            "@shared/*": ["./src/shared/*", "../shared/types/*"],
            "@shared": ["./src/shared/index.ts", "../shared/types/index.ts"]
        }
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}